<rule name="Support_Center Reverse Proxy" stopProcessing="true">
  <match url="^Support_Center(/.*)?$" />
  <action type="Rewrite" url="http://192.168.2.27:3026/Support_Center{R:1}" />
  <serverVariables>
    <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
    <set name="HTTP_X_FORWARDED_PROTO" value="https" />
    <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
  </serverVariables>
</rule>
